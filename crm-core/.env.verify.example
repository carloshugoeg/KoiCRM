# VERIFY-ONLY scaffolding — copy to .env.verify (gitignored). Never point at prod.
# Loaded only by control-koicrm. Refuse to run without KOICRM_VERIFY=1.

KOICRM_VERIFY=1

# App listens on a dedicated port so a normal `pnpm dev` on :3000 can coexist.
PORT=3100
AUTH_URL=http://127.0.0.1:3100
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Dedicated verify database name. Host must be localhost / 127.0.0.1.
# Docker Compose path (preferred): compose project koicrm-verify publishes host port 5436.
# Local Postgres stand-in (no Docker): use port 5432 and DB name koicrm_verify.
DATABASE_URL=postgres://app_user:app_pass@127.0.0.1:5436/koicrm_verify
DATABASE_ADMIN_URL=postgres://admin_user:admin_pass@127.0.0.1:5436/koicrm_verify

# Auth secret for verify only — not a production secret.
AUTH_SECRET=verify-only-auth-secret-change-me-not-for-prod

# Local MinIO (compose verify) or any disposable S3-compatible endpoint.
# Bucket prefix / name is verify-only. Never use production R2 credentials.
S3_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=koicrm-verify
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_URL=http://127.0.0.1:9100/koicrm-verify
S3_FORCE_PATH_STYLE=true

# Leave Google empty so OAuth buttons stay hidden during verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info
NODE_ENV=development

MEMBERSHIP_CONTACT_EMAIL=verify@test.local
MEMBERSHIP_CONTACT_LABEL="Koi Verify"
